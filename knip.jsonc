{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Scoped to unused FILES and duplicate exports. Removing this key turns the
  // full check on, and that remains an acceptance criterion rather than an
  // optional tidy-up — dead code was a real problem in the previous app (625
  // unused lines in one file, plus two orphaned modules), so this gate must end
  // up strict.
  //
  // Measured with the key removed, it reports 38 unused exports, 22 unused
  // exported types and 5 unused dependencies. Most are exported for tests or
  // for symmetry with a sibling that *is* used, so each needs a decision rather
  // than a delete — which is why it is its own piece of work and not part of
  // the move to this repository.
  "include": ["files", "duplicates"],

  "entry": ["app/**/{page,layout,loading,error,not-found,route,template}.tsx", "scripts/**/*.ts"],

  // `config/` is in scope. It was held out during the build-out, when it was a
  // leaf surface written a phase ahead of its consumers and knip reported the
  // whole directory as dead.
  "project": ["{app,components,config,lib,scripts}/**/*.{ts,tsx}"],
}
